{
  "name": "sideband",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.2",
      "@effect/platform-bun": "4.0.2",
      "@types/bun": "1.4.2",
      "@cloudflare/workers-types": "5.20261006.1",
      "wrangler": "4.148.0",
      "typescript": "7.0.2"
    }
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run --filter '@sideband/protocol' check"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "typescript": "catalog:"
  }
}
