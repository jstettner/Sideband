{
  "name": "sideband",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "effect": "4.0.3",
      "@effect/vitest": "4.0.3",
      "@effect/platform-bun": "4.0.3",
      "@types/bun": "1.4.2",
      "@types/node": "26.6.4",
      "@cloudflare/workers-types": "5.20261006.1",
      "wrangler": "4.148.0",
      "typescript": "7.0.2",
      "vitest": "5.0.3"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint && bun scripts/install-hooks.ts",
    "postinstall": "bun scripts/sync-reference.ts",
    "reference:sync": "bun scripts/sync-reference.ts --force",
    "check": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint && dprint check && bun run openapi:check",
    "format": "dprint fmt",
    "openapi": "bun packages/protocol/src/scripts/genOpenapi.ts",
    "openapi:check": "bun packages/protocol/src/scripts/genOpenapi.ts --check"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "dprint": "0.61.1",
    "effect": "catalog:",
    "oxlint": "1.87.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
