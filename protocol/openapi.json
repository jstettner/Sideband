{
  "openapi": "3.1.0",
  "info": {
    "title": "Sideband",
    "version": "1",
    "description": "HTTP contract between a Sideband client (the watch app) and a Sideband backend. See protocol/README.md.",
    "license": {
      "name": "MIT"
    }
  },
  "paths": {
    "/v1/turn": {
      "post": {
        "tags": [
          "turns"
        ],
        "operationId": "turns.submit",
