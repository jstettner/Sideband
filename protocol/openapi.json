                            "completed"
                          ]
                        },
                        "idempotency_key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{16,128}$",
                          "description": "16-128 characters of [A-Za-z0-9_-]. A UUID is fine."
                        },
                        "session": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                          "description": "Lowercase [a-z0-9_-], 1-64 characters, starting with a letter or digit."
                        },
                        "transcript": {
                          "type": "string"
                        },
                        "transcript_raw": {
                          "type": "string"
                        },
                        "watch_text": {
                          "type": "string"
                        },
                        "speak_text": {
                          "type": "string"
                        },
                        "full_text": {
                          "type": "string"
                        },
                        "context": {
                          "type": "object",
                          "properties": {
                            "used_tokens": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "limit_tokens": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "used_tokens",
                            "limit_tokens"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "idempotency_key",
                        "session",
                        "watch_text"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "needs_approval"
                          ]
                        },
                        "idempotency_key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{16,128}$",
                          "description": "16-128 characters of [A-Za-z0-9_-]. A UUID is fine."
                        },
                        "session": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                          "description": "Lowercase [a-z0-9_-], 1-64 characters, starting with a letter or digit."
                        },
                        "transcript": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "status",
                        "idempotency_key",
                        "session",
                        "message"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "failed"
                          ]
                        },
                        "idempotency_key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{16,128}$",
                          "description": "16-128 characters of [A-Za-z0-9_-]. A UUID is fine."
                        },
                        "session": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                          "description": "Lowercase [a-z0-9_-], 1-64 characters, starting with a letter or digit."
