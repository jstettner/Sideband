                        "transcript": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "status",
                        "idempotency_key",
                        "session",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "running"
                      ]
                    },
                    "idempotency_key": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{16,128}$",
                      "description": "16-128 characters of [A-Za-z0-9_-]. A UUID is fine."
                    },
                    "session": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                      "description": "Lowercase [a-z0-9_-], 1-64 characters, starting with a letter or digit."
                    },
                    "transcript": {
                      "type": "string"
                    },
                    "retry_after_ms": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "status",
                    "idempotency_key",
                    "session",
                    "retry_after_ms"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "InvalidRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidRequestEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "409": {
            "description": "SessionBusy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBusyEncoded"
                }
              }
            }
          },
          "413": {
            "description": "PayloadTooLarge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayloadTooLargeEncoded"
                }
              }
            }
          },
          "415": {
            "description": "UnsupportedMediaType",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedMediaTypeEncoded"
                }
              }
            }
          },
          "422": {
            "description": "IdempotencyConflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdempotencyConflictEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          },
          "502": {
            "description": "TranscriptionFailed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptionFailedEncoded"
                }
              }
            }
          },
          "503": {
            "description": "AgentOffline",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOfflineEncoded"
                }
              }
            }
          }
        },
        "description": "Submit one push-to-talk turn: raw `audio/wav` (16 kHz mono PCM16) body, or JSON `{ \"text\": ... }`. `session` names the conversation (e.g. `main`). Retrying with the same `Idempotency-Key` never runs the turn twice: it returns the stored outcome, or `running` while it is still in flight.",
        "requestBody": {
          "content": {
            "audio/wav": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          },
          "required": true
        }
      }
    },
