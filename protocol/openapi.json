                        "transcript": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string",
                          "enum": [
                            "agent_failed",
                            "interrupted"
                          ]
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "status",
                        "idempotency_key",
                        "session",
                        "code",
                        "message"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "unknown"
                          ]
                        },
                        "idempotency_key": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{16,128}$",
