# Local notes
.local/

# Dependencies / build output
node_modules/
dist/
*.tsbuildinfo
coverage/

# tsc -b declaration output (bun run check)
.tsbuild/

# read-only upstream clones, materialized by `bun install` (scripts/sync-reference.ts)
reference/*
!reference/.gitkeep

# Secrets and local config
.env
.env.*
!.env.example
!.env.prod.example
.dev.vars
.dev.vars.*
!.dev.vars.example
watch/Config/Local.xcconfig

# Alchemy: local state, dev logs, and bundles (`alchemy dev`, Workers tests)
.alchemy/

# Xcode (project is generated by XcodeGen from watch/project.yml)
watch/*.xcodeproj/
xcuserdata/
DerivedData/
*.xcuserstate
build/

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
