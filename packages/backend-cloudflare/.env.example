# Copy to .env (gitignored). `bun run dev` and `bun run test` read it; the Worker binds each as a secret.
WATCH_TOKEN=
RUNNER_TOKEN=
AQUA_API_KEY=
# Transcription provider; defaults to aqua (the only one so far).
# SIDEBAND_TRANSCRIPTION=aqua
# The Alchemy profile bare `bunx alchemy …` commands use from this directory (`bun run deploy` pins its own).
ALCHEMY_PROFILE=sideband
