{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": ["alchemy.run.ts", "src", "test"],
  "references": [
    { "path": "../protocol" },
    { "path": "../transcription" },
    { "path": "../agents" },
    { "path": "../runner" }
  ],
  "compilerOptions": {
    // alchemy.run.ts, the scripts, and the tests run on Node; Worker code is typed by Alchemy's resources.
    "types": ["node"],
    // Nothing imports the backend, so it is type-checked without emitting declarations.
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  }
}
