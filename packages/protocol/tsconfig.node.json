{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": ["src/scripts", "test"],
  "references": [{ "path": "." }],
  "compilerOptions": {
    "types": ["node"],
    // Nothing imports these files, so they are type-checked without emitting declarations.
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  }
}
