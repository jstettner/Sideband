{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test"],
  "references": [{ "path": "../protocol" }, { "path": "../agents" }],
  "compilerOptions": {
    "types": ["bun"],
    // Nothing imports the runner, so it is type-checked without emitting declarations.
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  }
}
