# Copy to .env (gitignored). `bun run start` reads it; `bun run runner:install` copies it to
# ~/.config/sideband/runner.env the first time, and the installed runner reads that file.
SIDEBAND_BACKEND_URL=wss://sideband.example.workers.dev
SIDEBAND_RUNNER_TOKEN=

# echo | hermes
SIDEBAND_AGENT=echo

# Hermes API server key (API_SERVER_KEY in ~/.hermes/.env). Never leaves this machine.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
