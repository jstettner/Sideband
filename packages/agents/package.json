    "./index": null
  },
  "dependencies": {
    "@sideband/protocol": "workspace:*"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  }
}
