{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test"],
  "compilerOptions": {
    // `types` stays [] (from the base): transcription is platform-free, so a Node, Bun, or Workers import fails
    // to type-check. DOM adds only the web-standard globals every host has (`FormData`, `Blob`).
    "lib": ["ES2023", "DOM"]
  }
}
