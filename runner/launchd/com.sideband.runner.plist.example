<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sideband.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/sideband/runner/dist/sideband-runner</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/sideband/runner</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after crashes, but not after a clean exit (another runner replaced this one). -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/com.sideband.runner.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.sideband.runner.log</string>
</dict>
</plist>
