# Copy to .env.prod (gitignored). `bun run plan` and `bun run deploy` read it; the prod Worker binds each as a
# secret, so a deploy sets them. Use the tokens the watch (watch/Config/Local.xcconfig) and the runner
# (SIDEBAND_RUNNER_TOKEN) are configured with.
WATCH_TOKEN=
RUNNER_TOKEN=
AQUA_API_KEY=
